FROM osrf/ros:jazzy-desktop

# ROS 2 stack + Mesa software rendering + VNC/noVNC tools
# (standalone image — does not depend on kumi:dev being pre-built)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    curl \
    sudo \
    python3-pip \
    python3-venv \
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-vcstool \
    pipx \
    ros-jazzy-ros-gz \
    ros-jazzy-gz-ros2-control \
    ros-jazzy-rmw-cyclonedds-cpp \
    ros-jazzy-py-trees \
    ros-jazzy-rclpy \
    ros-jazzy-tf2-ros \
    ros-jazzy-std-msgs \
    ros-jazzy-sensor-msgs \
    ros-jazzy-trajectory-msgs \
    ros-jazzy-controller-manager \
    ros-jazzy-ros2-controllers \
    ros-jazzy-joint-state-publisher-gui \
    ros-jazzy-robot-state-publisher \
    ros-jazzy-xacro \
    ros-jazzy-rviz2 \
    ros-jazzy-rmw-fastrtps-cpp \
    libgl1 \
    libglx-mesa0 \
    libgl1-mesa-dri \
    mesa-utils \
    x11-apps \
    ca-certificates \
    gnupg \
    xvfb \
    x11vnc \
    novnc \
    websockify \
    && rm -rf /var/lib/apt/lists/*

ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

RUN groupadd -f -r render
RUN rosdep init || true

# Copy entrypoint from build context root (context is repo root: ..)
COPY .devcontainer/novnc-entrypoint.sh /novnc-entrypoint.sh
RUN chmod +x /novnc-entrypoint.sh

WORKDIR /workspaces/kumi_stack
