<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="kumi">

    <xacro:if value="$(arg enable_sensors)">

        <material name="orange">
            <color rgba="0.8 0.4 0.0 1.0" />
        </material>
        <material name="purple">
            <color rgba="0.5 0.0 0.8 1.0" />
        </material>

        <xacro:macro name="corner_rgb_cam" params="name x y z yaw">
            <link name="${name}">
                <visual>
                    <origin xyz="0 0 0" rpy="0 0 0" />
                    <geometry>
                        <box size="0.012 0.012 0.012" />
                    </geometry>
                    <material name="purple" />
                </visual>
                <collision>
                    <origin xyz="0 0 0" rpy="0 0 0" />
                    <geometry>
                        <box size="0.012 0.012 0.012" />
                    </geometry>
                </collision>
                <inertial>
                    <origin xyz="0 0 0" rpy="0 0 0" />
                    <mass value="0.005" />
                    <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
                </inertial>
            </link>

            <joint name="${name}_joint" type="fixed">
                <parent link="body" />
                <child link="${name}" />
                <origin xyz="${x} ${y} ${z}" rpy="0 0 ${yaw}" />
            </joint>

            <gazebo reference="${name}">
                <sensor name="${name}" type="camera">
                    <always_on>true</always_on>
                    <visualize>true</visualize>
                    <update_rate>30</update_rate>
                    <topic>$(arg ros_namespace)/${name}/image</topic>
                    <camera_info_topic>$(arg ros_namespace)/${name}/camera_info</camera_info_topic>
                    <gz_frame_id>${name}</gz_frame_id>
                    <camera>
                        <horizontal_fov>1.3962634</horizontal_fov>
                        <image>
                            <width>640</width>
                            <height>480</height>
                            <format>R8G8B8</format>
                        </image>
                        <clip>
                            <near>0.05</near>
                            <far>50.0</far>
                        </clip>
                    </camera>
                </sensor>
            </gazebo>
        </xacro:macro>

        <xacro:macro name="corner_depth_cam" params="name x y z yaw">
            <link name="${name}">
                <visual>
                    <origin xyz="0 0 0" rpy="0 0 0" />
                    <geometry>
                        <box size="0.012 0.012 0.012" />
                    </geometry>
                    <material name="orange" />
                </visual>
                <collision>
                    <origin xyz="0 0 0" rpy="0 0 0" />
                    <geometry>
                        <box size="0.012 0.012 0.012" />
                    </geometry>
                </collision>
                <inertial>
                    <origin xyz="0 0 0" rpy="0 0 0" />
                    <mass value="0.005" />
                    <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
                </inertial>
            </link>

            <joint name="${name}_joint" type="fixed">
                <parent link="body" />
                <child link="${name}" />
                <origin xyz="${x} ${y} ${z}" rpy="0 0 ${yaw}" />
            </joint>

            <gazebo reference="${name}">
                <sensor name="${name}" type="depth_camera">
                    <always_on>true</always_on>
                    <visualize>true</visualize>
                    <update_rate>20</update_rate>
                    <topic>$(arg ros_namespace)/${name}/image</topic>
                    <camera_info_topic>$(arg ros_namespace)/${name}/camera_info</camera_info_topic>
                    <gz_frame_id>${name}</gz_frame_id>
                    <camera>
                        <horizontal_fov>1.22173</horizontal_fov>
                        <image>
                            <width>640</width>
                            <height>480</height>
                            <format>R_FLOAT32</format>
                        </image>
                        <clip>
                            <near>0.10</near>
                            <far>10.0</far>
                        </clip>
                    </camera>
                </sensor>
            </gazebo>
        </xacro:macro>

        <xacro:property name="cam_x" value="0.055" />
        <xacro:property name="cam_y" value="0.035" />
        <xacro:property name="cam_z_depth" value="0.015" />
        <xacro:property name="cam_z_rgb" value="-0.015" />

        <xacro:corner_depth_cam name="depth_cam_fl" x="${-cam_x}" y="${ cam_y}" z="${cam_z_depth}"
            yaw="${pi/4}" />
        <xacro:corner_rgb_cam name="rgb_cam_fl" x="${-cam_x}" y="${ cam_y}" z="${cam_z_rgb}"
            yaw="${pi/4}" />

        <xacro:corner_depth_cam name="depth_cam_fr" x="${-cam_x}" y="${-cam_y}" z="${cam_z_depth}"
            yaw="${pi/4}" />
        <xacro:corner_rgb_cam name="rgb_cam_fr" x="${-cam_x}" y="${-cam_y}" z="${cam_z_rgb}"
            yaw="${pi/4}" />

        <xacro:corner_depth_cam name="depth_cam_rl" x="${ cam_x}" y="${ cam_y}" z="${cam_z_depth}"
            yaw="${-3*pi/4}" />
        <xacro:corner_rgb_cam name="rgb_cam_rl" x="${ cam_x}" y="${ cam_y}" z="${cam_z_rgb}"
            yaw="${-3*pi/4}" />

        <xacro:corner_depth_cam name="depth_cam_rr" x="${ cam_x}" y="${-cam_y}" z="${cam_z_depth}"
            yaw="${3*pi/4}" />
        <xacro:corner_rgb_cam name="rgb_cam_rr" x="${ cam_x}" y="${-cam_y}" z="${cam_z_rgb}"
            yaw="${3*pi/4}" />

    </xacro:if>

</robot>